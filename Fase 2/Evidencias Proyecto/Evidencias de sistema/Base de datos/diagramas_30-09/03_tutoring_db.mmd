%% Pilar 2 · Anexo A v1.3 — Modelo de datos · Diagrama 3 de 5
%% tutoring_db — Servicio de Tutorías · 7 tablas
%% Los trece ajustes A-01 a A-13 quedaron aprobados el 14-09-2026.
%% Modelo IMPLEMENTADO el 30-09-2026 (migraciones de la semana 8). Difiere del anexo A
%% en lo que dejo la revision de 3FN: ver la presentacion de normalizacion.
%% usuario_ref y asignatura_ref son copias de lectura de otros servicios (AD-07).
%% Dentro de esta base son tablas normales, con FK reales: por eso la búsqueda de
%% tutores se resuelve sin una sola llamada HTTP.
erDiagram
    usuario_ref {
        uuid usuario_id PK "el id de identity_db es la PK · la fila nace al primer contacto con Tutorías (T-02)"
        varchar nombre "80 · copia"
        varchar apellido "80 · copia"
        uuid carrera_id "NULL · copia"
        uuid sede_id "NULL · copia"
        boolean activo "DEFAULT true · sin esta columna RN-08 no se cumple (A-01) · hasta 5 min de desfase"
        numeric reputacion_promedio "3 y 2 decimales · DEFAULT 0 · CHECK entre 0 y 5"
        integer reputacion_total "DEFAULT 0 · evaluaciones visibles · CHECK no negativa"
        timestamptz actualizado_en "DEFAULT now · mide el desfase que AD-07 acepta"
    }

    asignatura_ref {
        uuid asignatura_id PK "copia de lectura de catalog_db.asignatura"
        varchar sigla "15 · copia"
        varchar nombre "150 · copia"
        timestamptz actualizado_en "DEFAULT now"
    }

    perfil_tutor {
        uuid id PK "se expone en PATCH /perfiles/{id}"
        uuid usuario_id FK "ON DELETE CASCADE · único junto a asignatura_id"
        uuid asignatura_id FK "ON DELETE RESTRICT · habilitación validada con RN-01"
        numeric tarifa "8 enteros en pesos · DEFAULT 0 · CHECK no negativa · RN-05"
        varchar descripcion "500 · NULL"
        boolean activo "DEFAULT true · desactivar en vez de borrar"
        timestamptz creado_en "DEFAULT now"
        timestamptz actualizado_en "DEFAULT now"
    }

    bloque_disponibilidad {
        uuid id PK "gen_random_uuid"
        uuid usuario_id FK "ON DELETE CASCADE"
        timestamptz inicio_en "UTC · dos instantes en vez de fecha y horas (A-02) · solo futuro al crear"
        timestamptz fin_en "CHECK posterior a inicio_en · EXCLUDE gist impide solapar · RN-02"
        varchar estado "10 · LIBRE, OCUPADO o ELIMINADO · el EXCLUDE ignora los eliminados (T-169)"
        timestamptz creado_en "DEFAULT now"
        timestamptz actualizado_en "DEFAULT now"
    }

    reserva {
        uuid id PK "cruza a payment_db.pago.reserva_id"
        uuid bloque_id FK "ON DELETE RESTRICT · el tutor es el dueño del bloque (3FN) · único parcial (A-03)"
        uuid solicitante_usuario_id FK "distinto del dueño del bloque: disparador trg_reserva_no_auto · RN-03"
        uuid asignatura_id FK "ON DELETE RESTRICT"
        varchar estado "12 · DEFAULT SOLICITADA · siete valores · ver sección 9"
        varchar nota "500 · NULL · la escribe el solicitante · RF-07"
        varchar modalidad "12 · NULL · PRESENCIAL o EN_LINEA · obligatoria al confirmar · RN-07"
        varchar lugar_o_enlace "300 · NULL · lo indica el tutor al confirmar · RN-07"
        numeric monto "8 enteros · copia congelada de la tarifa al solicitar (A-04)"
        varchar estado_pago "12 · NULL · copia de lectura de Pagos · NULL si monto es 0"
        timestamptz pago_actualizado_en "NULL · descarta avisos fuera de orden (A-06)"
        uuid cancelada_por_usuario_id FK "NULL · quién canceló · RN-04 (A-05)"
        timestamptz creada_en "DEFAULT now"
        timestamptz confirmada_en "NULL"
        timestamptz cerrada_en "NULL · entrada a un estado terminal"
    }

    evaluacion {
        uuid id PK "se expone en DELETE /admin/evaluaciones/{id}"
        uuid reserva_id FK,UK "ON DELETE CASCADE · una sola por reserva · RN-06"
        smallint calificacion "CHECK entre 1 y 5 · RN-06"
        varchar comentario "500 · NULL"
        timestamptz retirada_en "NULL · retirada deja de contar en la reputación · CA7"
        uuid retirada_por_usuario_id "NULL · referencia lógica al administrador"
        timestamptz creada_en "DEFAULT now"
    }

    ejecucion_tarea {
        bigserial id PK "evidencia del programador · AD-10 · nueva en A-09"
        varchar comando "40 · nombre del comando de Django ejecutado"
        integer solicitudes_expiradas "DEFAULT 0 · RN-03"
        integer reservas_cerradas "DEFAULT 0 · paso a REALIZADA"
        integer refs_sincronizadas "DEFAULT 0 · copias de lectura refrescadas (A-01)"
        integer perfiles_desactivados "DEFAULT 0 · revalidación de RN-01 al cambiar carrera o nivel (A-13)"
        varchar error "300 · NULL"
        timestamptz iniciada_en "DEFAULT now"
        timestamptz terminada_en "NULL indica una ejecución interrumpida"
    }

    usuario_ref ||--o{ perfil_tutor : "declara asignaturas en"
    asignatura_ref ||--o{ perfil_tutor : "es tutoreada en"
    usuario_ref ||--o{ bloque_disponibilidad : "publica"
    bloque_disponibilidad ||--o{ reserva : "recibe solicitudes de"
    usuario_ref ||--o{ reserva : "solicita como estudiante"
    usuario_ref |o--o{ reserva : "canceló · RN-04"
    asignatura_ref ||--o{ reserva : "es la materia de"
    reserva ||--o| evaluacion : "recibe"
